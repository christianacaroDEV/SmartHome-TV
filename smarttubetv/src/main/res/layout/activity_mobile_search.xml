<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile search: search field (back + mic) + suggestions/history or results -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/smarthome_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="10dp"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/mobile_search_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:contentDescription="@string/mobile_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/search_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp">

            <EditText
                android:id="@+id/mobile_search_field"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/home_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8FA3CC"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/mobile_search_clear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="@null"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_m_close"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mobile_search_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/search_pill_bg"
            android:contentDescription="@null"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_m_mic" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls" />

        <ProgressBar
            android:id="@+id/mobile_search_progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
