<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Pulsing glow behind the logo -->
    <View
        android:id="@+id/splash_glow"
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_glow" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo" />

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/splash_tagline"
            android:textColor="#8FD8FF"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Indeterminate "scanner" loading bar (the fill is animated from code) -->
        <FrameLayout
            android:id="@+id/splash_bar_track"
            android:layout_width="280dp"
            android:layout_height="4dp"
            android:background="@drawable/splash_bar_track">

            <View
                android:id="@+id/splash_bar_fill"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:background="@drawable/splash_bar_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/splash_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/splash_loading"
            android:textColor="#7F93C0"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
